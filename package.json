{
    "name": "hnnx",
    "productName": "HNNX",
    "author": {
        "name": "Jonghyuk Park",
        "email": "hyukize@users.noreply.github.com",
        "url": "https://github.com/hyukize"
    },
    "version": "1.0.0-rc.5",
    "date": "2026-09-01 17:30:00",
    "description": "ONNX graph workbench for visualization, AIMET analysis, and graph editing",
    "license": "MIT",
    "repository": "hyukize/HNNX",
    "appId": "ai.mrxrunway.hnnx",
    "aimet": true,
    "disableUpdates": true,
    "type": "module",
    "main": "source/app.js",
    "scripts": {
        "start": "node package.js start",
        "server": "python3 package.py build start",
        "clean": "node package.js clean",
        "install": "node package.js install",
        "lint": "node package.js lint",
        "build": "node package.js build",
        "build:mac-hnnx": "node scripts/build-macos-hnnx.mjs",
        "build:windows-hnnx": "node scripts/build-platform-hnnx.mjs windows",
        "build:linux-hnnx": "node scripts/build-platform-hnnx.mjs linux",
        "build:vscode-hnnx": "npm --prefix vscode-extension run package",
        "sync:version": "node scripts/sync-version.mjs",
        "publish": "node package.js publish",
        "release": "node package.js release",
        "test": "node package.js test",
        "test:editor-mixed": "node package.js build web && playwright test --config=test/editor-mixed.playwright.config.js --workers=1",
        "test:editor-stage3": "node package.js build web && playwright test --config=test/editor-stage3.playwright.config.js --workers=1",
        "test:layout": "node test/dagre.js",
        "validate": "node package.js validate",
        "coverage": "node package.js coverage",
        "analyze": "node package.js analyze",
        "update": "node package.js update",
        "pull": "node package.js pull"
    },
    "dependencies": {
        "electron-updater": "6.8.9"
    },
    "devDependencies": {
        "@electron/notarize": "3.1.1",
        "@playwright/test": "1.61.1",
        "electron": "43.1.1",
        "electron-builder": "26.15.3",
        "eslint": "10.7.0"
    },
    "build": {
        "extends": "publish/electron-builder.json"
    },
    "nyc": {
        "reporter": [
            "lcov",
            "html"
        ],
        "report-dir": "dist/nyc/report",
        "temp-dir": "dist/nyc/.nyc_output"
    }
}
