{
    "name": "hnnx",
    "displayName": "HNNX",
    "description": "Visualize, analyze, and edit ONNX models with AIMET encoding support, including remote workspaces.",
    "version": "1.0.0",
    "publisher": "hyukize",
    "icon": "media/icon.png",
    "license": "MIT",
    "repository": {
        "type": "git",
        "url": "https://github.com/hyukize/HNNX.git"
    },
    "homepage": "https://github.com/hyukize/HNNX#readme",
    "bugs": {
        "url": "https://github.com/hyukize/HNNX/issues"
    },
    "galleryBanner": {
        "color": "#24384f",
        "theme": "dark"
    },
    "keywords": [
        "onnx",
        "aimet",
        "quantization",
        "mixed precision",
        "graphsurgeon",
        "machine learning",
        "visualization"
    ],
    "engines": {
        "vscode": "^1.90.0"
    },
    "categories": [
        "Visualization",
        "Machine Learning"
    ],
    "extensionKind": [
        "workspace"
    ],
    "main": "./extension.js",
    "activationEvents": [
        "onCustomEditor:hnnx.onnxViewer",
        "onCommand:hnnx.configureGraphSurgeonPython",
        "onCommand:hnnx.createGraphSurgeonEnvironment"
    ],
    "contributes": {
        "commands": [
            {
                "command": "hnnx.configureGraphSurgeonPython",
                "title": "HNNX: Configure GraphSurgeon Python"
            },
            {
                "command": "hnnx.createGraphSurgeonEnvironment",
                "title": "HNNX: Create GraphSurgeon Environment"
            }
        ],
        "customEditors": [
            {
                "viewType": "hnnx.onnxViewer",
                "displayName": "HNNX",
                "selector": [
                    {
                        "filenamePattern": "*.onnx"
                    }
                ],
                "priority": "default"
            }
        ],
        "configuration": {
            "title": "HNNX",
            "properties": {
                "hnnx.autoPinOnnxEditors": {
                    "type": "boolean",
                    "default": true,
                    "description": "Keep ONNX editor tabs open so switching to another file does not discard and reload the graph."
                },
                "hnnx.autoLoadEncodings": {
                    "type": "boolean",
                    "default": true,
                    "description": "Automatically load a conventionally named AIMET encodings file from the ONNX model directory when the model opens."
                },
                "hnnx.defaultEncodingsVisible": {
                    "type": "boolean",
                    "default": true,
                    "description": "Show attached AIMET encodings when a model opens. Encodings remain attached when hidden."
                },
                "hnnx.inferShapesOnOpen": {
                    "type": "boolean",
                    "default": false,
                    "description": "Run ONNX shape inference automatically after a model opens. Failures are reported without blocking the model viewer."
                },
                "hnnx.pythonPath": {
                    "type": "string",
                    "default": "",
                    "scope": "machine",
                    "markdownDescription": "Python interpreter containing `onnx` and NVIDIA `onnx_graphsurgeon`. In remote workspaces this path is resolved on the remote extension host. Use **HNNX: Create GraphSurgeon Environment** to create the recommended environment, or **HNNX: Configure GraphSurgeon Python** to validate and save an existing interpreter."
                },
                "hnnx.colorTheme": {
                    "type": "string",
                    "enum": [
                        "auto",
                        "light",
                        "dark"
                    ],
                    "enumDescriptions": [
                        "Follow the active VS Code color theme.",
                        "Always use the HNNX light theme.",
                        "Always use the HNNX dark theme."
                    ],
                    "default": "auto",
                    "description": "Controls the HNNX graph viewer color theme."
                }
            }
        }
    },
    "scripts": {
        "build:media": "node ./scripts/build-media.mjs",
        "package": "npm run build:media && npx --yes @vscode/vsce package --no-dependencies --out hnnx-1.0.0.vsix",
        "test": "node --test ./test/*.test.js"
    },
    "files": [
        "extension.js",
        "media/**",
        "README.md",
        "CHANGELOG.md",
        "SUPPORT.md",
        "LICENSE"
    ]
}
