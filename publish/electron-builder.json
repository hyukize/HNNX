{
    "appId": "ai.mrxrunway.hnnx",
    "productName": "HNNX",
    "copyright": "Copyright © 2026 Jonghyuk Park",
    "files": ["source/**/*"],
    "directories": {
        "buildResources": "./publish"
    },
    "fileAssociations": [
        {
            "ext": "onnx",
            "name": "ONNX Model"
        }
    ],
    "linux": {
        "artifactName": "HNNX-${version}-${arch}.${ext}",
        "category": "Development",
        "executableName": "hnnx",
        "maintainer": "Jonghyuk Park <hyukize@users.noreply.github.com>",
        "target": [
            {
                "target": "AppImage",
                "arch": ["x64"]
            },
            {
                "target": "deb",
                "arch": ["x64"]
            }
        ]
    },
    "mac": {
        "artifactName": "HNNX-${version}-${arch}.${ext}",
        "category": "public.app-category.developer-tools",
        "darkModeSupport": true,
        "identity": null,
        "notarize": false,
        "target": ["dmg"]
    },
    "win": {
        "artifactName": "HNNX-${version}-${arch}-setup.${ext}",
        "target": ["nsis"]
    },
    "dmg": {
        "artifactName": "HNNX-${version}-${arch}.${ext}",
        "title": "HNNX ${version}",
        "writeUpdateInfo": false,
        "iconSize": 160,
        "contents": [
            {
                "x": 180,
                "y": 170
            },
            {
                "x": 480,
                "y": 170,
                "type": "link",
                "path": "/Applications"
            }
        ]
    },
    "nsis": {
        "differentialPackage": false
    }
}
